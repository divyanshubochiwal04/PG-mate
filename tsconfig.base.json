{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@m-square/config": ["../../packages/config/dist/index.d.ts", "packages/config/dist/index.d.ts"],
      "@m-square/logger": ["../../packages/logger/dist/index.d.ts", "packages/logger/dist/index.d.ts"],
      "@m-square/domain": ["../../packages/domain/dist/index.d.ts", "packages/domain/dist/index.d.ts"],
      "@m-square/contracts": ["../../packages/contracts/dist/index.d.ts", "packages/contracts/dist/index.d.ts"],
      "@m-square/security": ["../../packages/security/dist/index.d.ts", "packages/security/dist/index.d.ts"],
      "@m-square/database": ["../../packages/database/dist/index.d.ts", "packages/database/dist/index.d.ts"]
    },
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": false,
    "resolveJsonModule": true,
    "incremental": true
  }
}
