{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@m-square/config": ["../config/dist/index.d.ts", "../config/dist/index.js"],
      "@m-square/contracts": ["../contracts/dist/index.d.ts", "../contracts/dist/index.js"],
      "@m-square/domain": ["../domain/dist/index.d.ts", "../domain/dist/index.js"],
      "@m-square/logger": ["../logger/dist/index.d.ts", "../logger/dist/index.js"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**", "src/**/*.spec.ts", "src/**/*.test.ts", "src/scripts/**"]
}
