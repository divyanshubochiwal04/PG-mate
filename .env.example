# ============================================================
# M SQUARE — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. It is already in .gitignore.
#
# Generate strong secrets with:
#   openssl rand -base64 32
# ============================================================

# --- Application ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database Connection ---
# Local Docker:  postgresql://postgres:<REPLACE_DB_PASSWORD>@localhost:5432/m_square
# Remote:        postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql://postgres:REPLACE_DB_PASSWORD@localhost:5432/m_square

# --- JWT Authentication ---
# REQUIRED. Must be at least 32 characters (256 bits).
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32_OUTPUT
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Storage Provider ---
# Options: local | supabase | s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=m-square-documents
STORAGE_LOCAL_PATH=./storage

# --- Supabase Storage (only required if STORAGE_PROVIDER=supabase) ---
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Argon2id Parameters (optional tuning) ---
# Defaults follow OWASP recommendations. Increase on higher-spec servers.
# ARGON2_MEMORY_COST=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=4
